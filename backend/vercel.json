{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/internal/cron/expire",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/v1/internal/cron/sync-xray",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/v1/internal/cron/notify",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/v1/internal/cron/reconcile-payments",
      "schedule": "*/5 * * * *"
    }
  ]
}
