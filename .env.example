# =============================================================================
#  .env — пример. Скопируйте:  cp .env.example .env
#  На Vercel те же переменные задаются в Settings → Environment Variables.
# =============================================================================

# ---------------------------------------------------------------- APP --------
APP_NAME="VPN Service"
APP_ENV=production                 # local | staging | production
DEBUG=false
API_BASE_PATH=/api/v1
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_random_32_chars_min
ACCESS_TOKEN_TTL_MINUTES=720
RATE_LIMIT_PER_MINUTE=120

# Уровни логов: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=

# Секрет для фоновых задач. На Vercel генерируется автоматически и
# подставляется в заголовок Authorization: Bearer <CRON_SECRET>.
# Пусто = cron-эндпоинты без авторизации (для локальной отладки).
CRON_SECRET=

# ------------------------------------------------------------ DATABASE ------
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/vpn
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------------------------------------------------------------- REDIS -----
# Опционально (rate-limit, кэш). Оставьте пустым, чтобы отключить.
REDIS_URL=

# ------------------------------------------------------------------ VPS -----
# SSH-доступ к VPN-серверу (Xray). Один узел; остальные добавляются в админке.
SERVER_HOST=
SERVER_PORT=22
SERVER_USER=root
# PEM-ключ. В .env записывается одной строкой с экранированными \n
SERVER_SSH_KEY=
SERVER_SSH_PASSPHRASE=
# Обязательно для защиты от MITM: ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub
SERVER_SSH_HOST_KEY_SHA256=
SERVER_SSH_TIMEOUT=20

# Публичные параметры, попадающие в клиентскую ссылку
VPN_DOMAIN=www.microsoft.com
VPN_PORT=443

# ------------------------------------------------------------------ XRAY ----
XRAY_CONFIG_PATH=/usr/local/share/xray/config.json
XRAY_SERVICE_NAME=xray
XRAY_RELOAD_MODE=restart            # restart | reload-sighup
XRAY_INBOUND_TAG=inbound-vless
XRAY_BINARY=xray

# REALITY
REALITY_TARGET=www.microsoft.com:443
REALITY_SERVER_NAMES=www.microsoft.com
REALITY_SHORT_IDS=                   # пусто = сгенерировать автоматически
REALITY_FINGERPRINT=chrome

# ------------------------------------------------------------- TELEGRAM -----
BOT_TOKEN=
# Публичный URL Web App (его же использует бот как URL вебхука)
WEBAPP_URL=https://example.com
WEBAPP_SHORT_NAME=app
# Telegram ID администраторов, через запятую
ADMIN_TELEGRAM_IDS=
SUPPORT_USERNAME=
BOT_NAME=VPN Bot
# Максимальный возраст initData, секунд (86400 = сутки)
INIT_DATA_MAX_AGE=86400

# ------------------------------------------------------------- PAYMENT ------
# mock   — тестовый шлюз без внешних запросов
# rollypay — боевой (раздел 9)
PAYMENT_PROVIDER=mock
PAYMENT_TOKEN=
CURRENCY=RUB
PAYMENT_RETURN_URL=

# Тестовый шлюз
MOCK_PAYMENT_AUTO_CONFIRM=false
MOCK_PAYMENT_RETURN_URL=https://example.com/paid

# --- Rollypay ---------------------------------------------------------------
# ВНИМАНИЕ: сверьте пути и формат полей с документацией Rollypay
# (публичный сайт провайдера был недоступен при написании кода).
ROLLYPAY_API_URL=https://api.rollypay.com/v1
ROLLYPAY_CREATE_PATH=/goods/create
ROLLYPAY_STATUS_PATH=/goods/info
ROLLYPAY_REFUND_PATH=/goods/refund
ROLLYPAY_WEBHOOK_PATH=/hook/rollypay
ROLLYPAY_SHOP_ID=
ROLLYPAY_SIGNATURE_HEADER=signature

# ---------------------------------------------------------------- PLANS ------
# Стартовый тариф создаётся при первом запуске, если каталог пуст.
SEED_PLANS_ON_STARTUP=true
SEED_PLAN_30D_TITLE=VPN 30 дней
SEED_PLAN_30D_DAYS=30
SEED_PLAN_30D_PRICE=29900            # копейки: 29900 = 299 ₽

# -------------------------------------------------------------- WORKERS ------
WORKER_EXPIRY_CHECK_INTERVAL=300
WORKER_XRAY_SYNC_INTERVAL=120
WORKER_NOTIFY_INTERVAL=3600
WORKER_PAYMENT_RECONCILE_INTERVAL=120
WORKER_HEALTH_CHECK_INTERVAL=300
# За сколько дней до конца слать напоминание
EXPIRY_NOTIFY_DAYS=3,1,0

# --------------------------------------------------------------- FRONT ------
# URL API для фронтенда (собирается в VITE_API_URL на этапе build)
CORS_ORIGINS=https://example.com
WEBAPP_THEME_DEFAULT=auto            # auto | light | dark
